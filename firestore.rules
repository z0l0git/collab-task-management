rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validProfile(data, userId) {
      return data.id == userId
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() <= 320
        && data.emailLower == data.email.lower()
        && (data.photoURL == null || data.photoURL is string);
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSelf(userId)
        && validProfile(request.resource.data, userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSelf(userId)
        && validProfile(request.resource.data, userId)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {

      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }

      function isWorkspaceOwner() {
        return isSignedIn() && request.auth.uid == resource.data.ownerId;
      }

      function validWorkspace(data) {
        return data.name is string
          && data.name.size() > 0
          && data.name.size() <= 80
          && data.description is string
          && data.description.size() <= 500
          && data.ownerId is string
          && data.memberIds is list
          && data.memberIds.size() > 0
          && data.memberIds.size() <= 50
          && data.members is map
          && data.labels is list
          && data.labels.size() <= 50
          && (!('statuses' in data) || validStatuses(data.statuses))
          && data.ownerId in data.memberIds;
      }

      function validStatuses(statuses) {
        return statuses is map
          && statuses.size() > 0
          && statuses.size() <= 20;
      }

      function ownerUnchanged() {
        return request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function isLeaving() {
        return isMember()
          && request.auth.uid != resource.data.ownerId
          && !(request.auth.uid in request.resource.data.memberIds)
          && request.resource.data.memberIds.size() ==
             resource.data.memberIds.size() - 1
          && request.resource.data.name == resource.data.name
          && request.resource.data.description == resource.data.description
          && request.resource.data.labels == resource.data.labels
          && request.resource.data.get('statuses', null) ==
             resource.data.get('statuses', null);
      }

      allow read: if isMember();

      allow create: if isSignedIn()
        && validWorkspace(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members[request.auth.uid].role == 'owner'
        && request.resource.data.labels == []
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if validWorkspace(request.resource.data)
        && ownerUnchanged()
        && request.resource.data.updatedAt == request.time
        && (isWorkspaceOwner() || isLeaving());

      allow delete: if isWorkspaceOwner();

      match /tasks/{taskId} {

        function workspace() {
          return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
        }

        function isWorkspaceMember() {
          return isSignedIn() && request.auth.uid in workspace().memberIds;
        }

        function statusIds() {
          return workspace().get('statuses',
            {'todo': true, 'in_progress': true, 'done': true}).keys();
        }

        function validTask(data, allowedAssignees, allowedLabels,
            allowedStatuses) {
          return data.keys().hasOnly(['title', 'description', 'status',
              'priority', 'assigneeId', 'dueDate', 'labels', 'order',
              'createdBy', 'createdAt', 'updatedAt'])
            && data.title is string
            && data.title.size() > 0
            && data.title.size() <= 200
            && data.description is string
            && data.description.size() <= 5000
            && data.status is string
            && data.status in allowedStatuses
            && data.priority in ['low', 'medium', 'high', 'urgent']
            && (data.assigneeId == null || data.assigneeId in allowedAssignees)
            && (data.dueDate == null || data.dueDate is timestamp)
            && data.labels is list
            && data.labels.size() <= 10
            && data.labels.hasOnly(allowedLabels)
            && data.order is number
            && data.createdBy is string;
        }

        allow read: if isWorkspaceMember();

        allow create: if isWorkspaceMember()
          && validTask(request.resource.data, workspace().memberIds,
              workspace().labels, statusIds())
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isWorkspaceMember()
          && validTask(request.resource.data,
              workspace().memberIds.concat([resource.data.assigneeId]),
              workspace().labels.concat(resource.data.labels),
              statusIds().concat([resource.data.status]))
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isWorkspaceMember()
          && (resource.data.createdBy == request.auth.uid
            || workspace().ownerId == request.auth.uid);

        function taskExists() {
          return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/tasks/$(taskId));
        }

        match /comments/{commentId} {
          function validComment(data) {
            let author = workspace().members[request.auth.uid];
            return data.keys().hasOnly(['authorId', 'authorName',
                'authorPhotoURL', 'message', 'createdAt'])
              && data.authorId == request.auth.uid
              && data.authorName == author.displayName
              && data.authorPhotoURL == author.photoURL
              && data.message is string
              && data.message.size() > 0
              && data.message.size() <= 2000
              && data.createdAt == request.time;
          }

          allow read: if isWorkspaceMember();
          allow create: if isWorkspaceMember()
            && taskExists()
            && validComment(request.resource.data);
          allow update: if false;
          allow delete: if isWorkspaceMember()
            && resource.data.authorId == request.auth.uid;
        }

        match /attachments/{attachmentId} {
          function validAttachment(data) {
            return data.keys().hasOnly(['name', 'size', 'contentType',
                'storagePath', 'uploadedBy', 'createdAt'])
              && data.name is string
              && data.name.size() > 0
              && data.name.size() <= 255
              && data.size is int
              && data.size > 0
              && data.size <= 10 * 1024 * 1024
              && data.contentType is string
              && data.storagePath == 'workspaces/' + workspaceId + '/tasks/'
                + taskId + '/' + attachmentId
              && data.uploadedBy == request.auth.uid
              && data.createdAt == request.time;
          }

          allow read: if isWorkspaceMember();
          allow create: if isWorkspaceMember()
            && taskExists()
            && validAttachment(request.resource.data);
          allow update: if false;
          allow delete: if isWorkspaceMember();
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
