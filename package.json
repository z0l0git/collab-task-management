{
  "name": "collab-task-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "firebase emulators:exec --project demo-collab-task --only auth,firestore,storage --ui $([ -d ./.emulator-data ] && echo --import ./.emulator-data) --export-on-exit ./.emulator-data \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,mts,css,json,mjs,yml,yaml}\" README.md",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,css,json,mjs,yml,yaml}\" README.md",
    "test:rules": "node tests/rules/index.mjs",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "emulators": "firebase emulators:start --project demo-collab-task --only auth,firestore,storage $([ -d ./.emulator-data ] && echo --import ./.emulator-data) --export-on-exit ./.emulator-data",
    "emulators:export": "firebase emulators:export ./.emulator-data --project demo-collab-task --force"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "firebase": "^12.5.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "^14.24.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
